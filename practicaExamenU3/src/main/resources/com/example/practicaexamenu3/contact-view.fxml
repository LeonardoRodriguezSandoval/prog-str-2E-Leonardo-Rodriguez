<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="400.0" prefWidth="600.0" spacing="20"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.practicaexamenu3.controllers.ContactController">

    <children>

        <GridPane prefHeight="209.0" prefWidth="600.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>

            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <children>

                <Label alignment="CENTER" text="Registro de contactos de emergencia" textAlignment="CENTER" translateX="45.0" translateY="-10.0">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>

                <Label text="Nombre:" translateX="20.0" GridPane.rowIndex="1">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>

                <Label text="Telefono:" translateX="20.0" GridPane.rowIndex="2">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>

                <Label text="Parentesco:" translateX="20.0" GridPane.rowIndex="3">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>

                <TextField fx:id="txtNombre" style="-fx-background-color: white; -fx-border-radius: 20; -fx-border-color: grey; -fx-border-width: 1;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <TextField fx:id="txtTelefono" style="-fx-background-color: white; -fx-border-radius: 20; -fx-border-color: grey; -fx-border-width: 1;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <ComboBox fx:id="cbParentesco" prefWidth="150.0" promptText="Eliga el parentesco" style="-fx-border-radius: 20;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            </children>
        </GridPane>

        <GridPane prefHeight="30.0" prefWidth="529.0">

            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="287.0" minWidth="10.0" prefWidth="116.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="358.0" minWidth="10.0" prefWidth="145.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="382.0" minWidth="10.0" prefWidth="106.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="382.0" minWidth="10.0" prefWidth="235.0" />
            </columnConstraints>

            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <children>

                <Button text="Agregar" onAction="#agregar" style="-fx-background-color: blue; -fx-border-radius: 50;" textFill="WHITE" translateX="20.0">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button text="Buscar" onAction="#buscar" prefWidth="93.0" style="-fx-background-color: blue; -fx-border-radius: 50;" textFill="WHITE" translateX="20.0" GridPane.columnIndex="1">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button text="Actualizar" onAction="#actualizar" style="-fx-background-color: blue; -fx-border-radius: 50;" textFill="WHITE" translateX="20.0" GridPane.columnIndex="2">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button text="Eliminar" onAction="#eliminar" style="-fx-background-color: red; -fx-border-radius: 50;" textFill="WHITE" translateX="20.0" GridPane.columnIndex="3">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

            </children>
        </GridPane>

        <ListView fx:id="listView" prefHeight="153.0" prefWidth="600.0" />

    </children>
</VBox>